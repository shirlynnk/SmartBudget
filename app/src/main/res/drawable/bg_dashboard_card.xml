<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Translucent glass base (approx 75-80% opacity) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="315"
                android:centerColor="#B30D252E"
                android:endColor="#B308191F"
                android:startColor="#CC143D47"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#5530D5D0" />
        </shape>
    </item>

    <!-- Top right soft turquoise glass glow -->
    <item
        android:width="150dp"
        android:height="150dp"
        android:gravity="top|end"
        android:right="-40dp"
        android:top="-50dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#3330D5D0"
                android:endColor="#0030D5D0"
                android:gradientRadius="75dp"
                android:type="radial" />
        </shape>
    </item>

    <!-- Bottom left subtle glow -->
    <item
        android:width="120dp"
        android:height="120dp"
        android:gravity="bottom|start"
        android:bottom="-40dp"
        android:left="-40dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#26328C89"
                android:endColor="#00328C89"
                android:gradientRadius="60dp"
                android:type="radial" />
        </shape>
    </item>

</layer-list>
